# ── LLM access ────────────────────────────────────────────────
# OpenRouter gives multi-provider access behind one key.
# Get one at https://openrouter.ai/keys and add a few $ of credit.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Datastores ────────────────────────────────────────────────
DATABASE_URL=postgres://ollive:ollive@localhost:5432/ollive
REDIS_URL=redis://localhost:6379

# ── Service wiring ────────────────────────────────────────────
# Where the SDK ships inference logs (the Fastify ingestion API).
INGESTION_URL=http://localhost:4000

# ── Behaviour flags ───────────────────────────────────────────
# Redact PII (emails, phones, cards, secrets) from stored previews.
REDACT_PII=true

# Web app port (Next.js) and ingestion port (Fastify).
WEB_PORT=3000
INGESTION_PORT=4000
