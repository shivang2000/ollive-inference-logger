# ── LLM access ────────────────────────────────────────────────
# OpenRouter gives multi-provider access behind one key.
# Get one at https://openrouter.ai/keys. The default model below is FREE, so a key
# with no credit works out of the box; add credit only to use the paid models.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model. A free OpenRouter model (zero token cost, rate-limited shared pool).
DEFAULT_MODEL=openai/gpt-oss-120b:free

# ── Datastores ────────────────────────────────────────────────
DATABASE_URL=postgres://ollive:ollive@localhost:5432/ollive
REDIS_URL=redis://localhost:6379

# ── Service wiring ────────────────────────────────────────────
# Where the SDK ships inference logs (the Fastify ingestion API).
INGESTION_URL=http://localhost:4000

# ── Behaviour flags ───────────────────────────────────────────
# Redact PII (emails, phones, cards, secrets) from stored previews.
REDACT_PII=true

# Web app port (Next.js) and ingestion port (Fastify).
WEB_PORT=3000
INGESTION_PORT=4000
