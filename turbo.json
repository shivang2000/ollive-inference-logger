{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "OPENROUTER_API_KEY",
    "DATABASE_URL",
    "REDIS_URL",
    "INGESTION_URL",
    "REDACT_PII",
    "WEB_PORT",
    "INGESTION_PORT",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
